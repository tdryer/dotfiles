{
  "allowPty": true,
  "command": {
    // silence irrelevant warning
    "acceptSharedBinaryCannotRuntimeDeny": ["chroot"]
  },
  "network": {
    "allowedDomains": [
      "api.github.com",
      "pypi.org",
      "files.pythonhosted.org",
      "openrouter.ai",
      "index.crates.io",
      "static.crates.io",
      "static.rust-lang.org",
      "proxy.golang.org",
      "golang.org",
      "storage.googleapis.com",
      "sum.golang.org"
    ]
  },
  "filesystem": {
    "defaultDenyRead": true,
    "allowGitConfig": true,
    "allowWrite": [
      "~/.codex",
      "~/.cache/copilot",
      "~/.cache/go-build",
      "~/.cache/opencode/",
      "~/.config/opencode",
      "~/.local/share/opencode/",
      "~/.local/state/opencode/",
      "~/.cache/uv/",
      "~/.local/share/nvim",
      "~/.local/share/uv/",
      "~/.local/state/nvim",
      "~/.cargo",
      "~/.copilot",
      "~/.rustup",
      "~/go",
      "."
    ]
  }
}
